# Copy to .env for the Library CLI (`npm run ingest`, `library:list`,
# `library:remove`). It reaches R2 through its S3-compatible API: create an
# R2 API token with Object Read & Write on the `mnemosyne-originals` and
# `mnemosyne-web` buckets (Cloudflare dashboard → R2 → Manage API tokens).
# The account ID is shown on the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The Library root (ADR 0006): the folder holding all the Originals, with a
# subfolder per trip or event. Required by `npm run ingest` only. Each Clip's
# folder is recorded relative to it, so `npm run ingest Malta` ingests
# <LIBRARY_ROOT>/Malta from anywhere, and `npm run ingest` ingests all of it.
LIBRARY_ROOT=
